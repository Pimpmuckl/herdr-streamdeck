{
  "name": "herdr-streamdeck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "check": "tsc --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --skipLibCheck --outDir .preview src/model.ts src/herdr-themes.ts src/theme.ts && node --experimental-strip-types --test src/model.test.mjs",
    "typecheck": "tsc --noEmit",
    "themes:sync": "node scripts/sync-herdr-themes.mjs",
    "preview": "tsc --target ES2022 --module NodeNext --moduleResolution NodeNext --strict --skipLibCheck --outDir .preview src/model.ts src/herdr-themes.ts src/render.ts && node scripts/render-preview.mjs",
    "validate": "streamdeck validate dev.herdr.streamdeck.sdPlugin",
    "profile:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-profile.ps1 -DryRun",
    "package:dry-run": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1 -DryRun",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1"
  },
  "dependencies": {
    "@elgato/streamdeck": "2.1.0"
  },
  "devDependencies": {
    "@elgato/cli": "1.7.4",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@tsconfig/node20": "20.1.9",
    "@types/node": "24.13.3",
    "rollup": "4.62.3",
    "tslib": "2.8.1",
    "typescript": "5.9.3"
  }
}
